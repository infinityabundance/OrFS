# OrFS end-to-end application-workload image (Phase 81).
#
# Derived from the same pinned Rust base so it can build the `orfs` binary and
# mount a real OrFS volume, and additionally carries the *real user-space tools*
# the application courts drive against the mount:
#
#   * git       — repository init/add/commit/clone/gc;
#   * sqlite3   — create/insert (WAL + fsync)/indexed-query/VACUUM;
#   * tar/gzip  — extract a bounded synthetic OCI-layer-like tarball;
#   * gcc/make  — compile and link a generated C project with `make -j`;
#   * fuse3 + util-linux — so an OrFS volume can actually be mounted here;
#   * jq + procps + file + coreutils — runner/evidence helpers.
#
# This image is deliberately separate from `Dockerfile.posix`/`Dockerfile.kmount`:
# their image digests are cited in committed receipts and must not move. Keep the
# FROM digest in sync with scripts/lib.sh:ORFS_BASE_IMAGE.
#
# Build:  scripts/container-image-build.sh
FROM rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        file \
        fuse3 \
        git \
        gcc \
        gzip \
        jq \
        make \
        procps \
        sqlite3 \
        tar \
        util-linux \
    ; \
    rm -rf /var/lib/apt/lists/*

ENV CARGO_TERM_COLOR=never

WORKDIR /work

CMD ["sh", "-c", "git --version; sqlite3 --version; gcc --version | head -1; make --version | head -1; tar --version | head -1; fusermount3 --version; ls -l /dev/fuse"]
