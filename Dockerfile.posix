# OrFS standard-POSIX-suite image (Phase 24).
#
# Derived from the same pinned Rust base so it can build the `orfs` binary, and
# additionally carries the toolchain and the vendored, commit-pinned pjdfstest
# suite that the §33 "broad POSIX court" runs:
#
#   * build tooling for pjdfstest (autoconf/automake/gcc/make),
#   * a TAP-capable Perl + openssl + gawk (the suite's `namegen` shell helpers),
#   * fuse3 + util-linux so an OrFS volume can be mounted inside this image,
#   * jq so the in-container runner can assemble its evidence JSON.
#
# The suite is fetched at image-build time and pinned to an immutable commit; the
# resolved commit is written to /opt/pjdfstest/COMMIT and recorded in
# evidence/correctness/pjdfstest.json. Network at image build only.
#
# Keep the FROM digest in sync with scripts/lib.sh:ORFS_BASE_IMAGE.
#
# Build:  scripts/container-image-build.sh
FROM rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa

# Pinned pjdfstest revision (github.com/pjd/pjdfstest). Recorded in the evidence
# so a result is always traceable to an exact suite commit.
ARG PJDFSTEST_COMMIT=85a8aea9e685999ef0540392fd80535f873d7ff7

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        file \
        git \
        fuse3 \
        util-linux \
        procps \
        perl \
        openssl \
        gawk \
        jq \
        gcc \
        make \
        autoconf \
        automake \
        pkg-config \
    ; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    git clone https://github.com/pjd/pjdfstest.git /opt/pjdfstest; \
    cd /opt/pjdfstest; \
    git checkout "$PJDFSTEST_COMMIT"; \
    git rev-parse HEAD > /opt/pjdfstest/COMMIT; \
    test "$(cat /opt/pjdfstest/COMMIT)" = "$PJDFSTEST_COMMIT"; \
    autoreconf -ifs; \
    ./configure; \
    make pjdfstest; \
    ./pjdfstest pathconf . _PC_NAME_MAX >/dev/null; \
    ls -l /opt/pjdfstest/pjdfstest

ENV CARGO_TERM_COLOR=never

WORKDIR /work

CMD ["sh", "-c", "cat /opt/pjdfstest/COMMIT; /opt/pjdfstest/pjdfstest pathconf . _PC_NAME_MAX"]
