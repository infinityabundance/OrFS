      "fields": [
        {"group": 1, "label": "history mean_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=full].measured_paths_4k[path=history].mean_ns"},
        {"group": 2, "label": "history min_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=full].measured_paths_4k[path=history].min_ns"}
      ]
