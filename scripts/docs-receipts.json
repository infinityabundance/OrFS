{
  "schema": "orfs.docs-receipts.v1",
  "description": "Machine-readable mapping used by scripts/check-docs-receipts.sh. It (a) allowlists provenance receipts that are intentionally historical and (b) curates the doc->evidence number citations that are checked. See docs/RECEIPTS.md for the exact coverage.",
  "provenance": {
    "receipts_dir": "evidence/receipts",
    "commit_fields": ["orfs_git_commit", "source_commit", "audited_head_commit"],
    "allowlist": [
      {
        "receipt": "crates-io.json",
        "field": "source_commit",
        "reason": "A crates.io publish record necessarily names the commit that was *published* (a historical ancestor of any later HEAD). It is a point-in-time publication receipt, not a claim of current-tree coverage."
      },
      {
        "receipt": "acceptance-audit.json",
        "field": "audited_head_commit",
        "reason": "An independent acceptance audit is a point-in-time record at the commit that was audited. It is historical by nature and must never be rewritten to a newer commit (doing so would fabricate coverage)."
      },
      {
        "receipt": "acceptance-audit-v4.json",
        "field": "audited_head_commit",
        "reason": "An independent acceptance audit re-run is a point-in-time record at the commit that was audited (the second run of the two-run tag/HEAD diff). It is historical by nature and must never be rewritten to a newer commit; like the v3 receipt, it records the exact HEAD it was run at."
      },
      {
        "receipt": "source-commit.json",
        "field": "orfs_git_commit",
        "reason": "A provenance receipt captured at the moment evidence was generated. It is regenerated on demand and its recorded commit is the ancestor the evidence was produced at, not a claim of current-tree coverage; the commit it names need not be HEAD."
      }
    ]
  },
  "default_tolerance": {
    "rel": 0.05,
    "abs": 0.0
  },
  "citations": [
    {
      "id": "perf-s5-frontier-history",
      "doc": "docs/PERFORMANCE.md",
      "section": "§5.2",
      "claim": "frontier table: profile `full`, `history` path mean/min (ns)",
      "regex": "\\|\\s*`history`\\s*\\|\\s*([0-9][0-9\\s]*?)\\s*ns\\s*\\|\\s*([0-9][0-9\\s]*?)\\s*ns\\s*\\|",
      "fields": [
        {"group": 1, "label": "history mean_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=full].measured_paths_4k[path=history].mean_ns"},
        {"group": 2, "label": "history min_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=full].measured_paths_4k[path=history].min_ns"}
      ]
    },
    {
      "id": "perf-s5-frontier-logical",
      "doc": "docs/PERFORMANCE.md",
      "section": "§5.2",
      "claim": "frontier table: profile `full`, `logical-extent` (authoritative) mean/min (ns)",
      "regex": "\\|\\s*`logical-extent`\\s*\\(authoritative\\)\\s*\\|\\s*\\*\\*([0-9][0-9\\s]*?)\\s*ns\\*\\*\\s*\\|\\s*\\*\\*([0-9][0-9\\s]*?)\\s*ns\\*\\*\\s*\\|",
      "fields": [
        {"group": 1, "label": "logical-extent mean_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=full].measured_paths_4k[path=logical-extent].mean_ns"},
        {"group": 2, "label": "logical-extent min_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=full].measured_paths_4k[path=logical-extent].min_ns"}
      ]
    },
    {
      "id": "perf-s5-frontier-maxspeed",
      "doc": "docs/PERFORMANCE.md",
      "section": "§5.2",
      "claim": "frontier inline: profile `max-speed` exposes `checkpoint` and `path-bloom` mean (ns)",
      "regex": "(`checkpoint`)\\s+([0-9][0-9\\s]*?)\\s*ns[\\s\\S]*?(`path-bloom`)\\s+([0-9][0-9\\s]*?)\\s*ns",
      "fields": [
        {"group": 2, "label": "max-speed checkpoint mean_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=max-speed].measured_paths_4k[path=checkpoint].mean_ns"},
        {"group": 4, "label": "max-speed path-bloom mean_ns", "evidence": "evidence/performance/ekbloom-frontier.json", "path": "profiles[summary.label=max-speed].measured_paths_4k[path=path-bloom].mean_ns"}
      ]
    },
    {
