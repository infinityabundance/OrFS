{
  "schema": "orfs.docs-receipts.v1",
  "description": "Machine-readable mapping used by scripts/check-docs-receipts.sh. It (a) allowlists provenance receipts that are intentionally historical and (b) curates the doc->evidence number citations that are checked. See docs/RECEIPTS.md for the exact coverage.",
  "provenance": {
    "receipts_dir": "evidence/receipts",
    "commit_fields": ["orfs_git_commit", "source_commit", "audited_head_commit"],
    "allowlist": [
      {
        "receipt": "crates-io.json",
        "field": "source_commit",
        "reason": "A crates.io publish record necessarily names the commit that was *published* (a historical ancestor of any later HEAD). It is a point-in-time publication receipt, not a claim of current-tree coverage."
      },
      {
        "receipt": "acceptance-audit.json",
        "field": "audited_head_commit",
        "reason": "An independent acceptance audit is a point-in-time record at the commit that was audited. It is historical by nature and must never be rewritten to a newer commit (doing so would fabricate coverage)."
      },
      {
        "receipt": "acceptance-audit-v4.json",
        "field": "audited_head_commit",
        "reason": "An independent acceptance audit re-run is a point-in-time record at the commit that was audited (the second run of the two-run tag/HEAD diff). It is historical by nature and must never be rewritten to a newer commit; like the v3 receipt, it records the exact HEAD it was run at."
      },
      {
        "receipt": "source-commit.json",
        "field": "orfs_git_commit",
        "reason": "A provenance receipt captured at the moment evidence was generated. It is regenerated on demand and its recorded commit is the ancestor the evidence was produced at, not a claim of current-tree coverage; the commit it names need not be HEAD."
      }
    ]
  },
  "default_tolerance": {
    "rel": 0.05,
    "abs": 0.0
  },
  "citations": [
    {
